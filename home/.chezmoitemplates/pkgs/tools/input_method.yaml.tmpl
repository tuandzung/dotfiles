{{- if eq .chezmoi.os "linux"}}
{{- if not .isHeadless }}
name: fcitx5
method: os
is_essential: true
gentoo:
  packages:
    - name: app-i18n/fcitx-configtool
    - name: app-i18n/fcitx-lotus
      repo: dynamo
  hook:
    after: |-
      sudo ln -s /etc/init.d/fcitx5-lotus /etc/init.d/fcitx5-lotus.$(whoami)
      sudo rc-update add fcitx5-lotus.$(whoami) default
      sudo rc-service fcitx5-lotus.$(whoami) restart
arch:
  packages:
    - name: fcitx5-configtool
    - name: fcitx5-lotus
  hook:
    after: |-
      sudo systemctl enable --now fcitx5-lotus-server@$(whoami).service
ubuntu:
  packages:
    - name: fcitx5-configtool
    - name: fcitx5-lotus
      repo_name: fcitx-lotus
      repo_url: https://fcitx5-lotus.pages.dev/apt/{{ .chezmoi.osRelease.versionCodename }}
      repo_version: {{ .chezmoi.osRelease.versionCodename }} main
      key: https://fcitx5-lotus.pages.dev/pubkey.gpg
  hook:
    after: |-
      sudo systemctl enable --now fcitx5-lotus-server@$(whoami).service
{{- end }}
{{- end }}
