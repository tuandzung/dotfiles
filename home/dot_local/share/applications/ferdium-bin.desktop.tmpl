{{- $ferdium := "flatpak run --socket=wayland org.ferdium.Ferdium" }}
{{- if eq .osid "linux-gentoo" "linux-arch" }}
{{-   $ferdium := "/usr/bin/ferdium" }}
{{-   if eq .osid "linux-gentoo" }}
{{-     $ferdium = "/usr/bin/ferdium-bin" }}
{{-   end }}
{{- end }}
[Desktop Entry]
Name=Ferdium (Wayland)
Exec={{ $ferdium }} --enable-webrtc-pipewire-capturer --enable-features=UseOzonePlatform --ozone-platform=wayland --enable-wayland-ime --wayland-text-input-version=3 %U
Terminal=false
Type=Application
Icon=ferdium
StartupWMClass=Ferdium
Comment=Desktop app bringing all your messaging services into one installable
MimeType=x-scheme-handler/ferdium;
Categories=Network;InstantMessaging;
