binds {
    Mod+Escape { toggle-keyboard-shortcuts-inhibit; }

    Mod+1 { focus-workspace "term"; }
    Mod+2 { focus-workspace "web"; }
    Mod+3 { focus-workspace "mail"; }
    Mod+4 { focus-workspace "chat"; }
    Mod+5 { focus-workspace "media"; }
    Mod+6 { focus-workspace "games"; }
    Mod+7 { focus-workspace "office"; }
    Mod+8 { focus-workspace "vm"; }
    Mod+9 { focus-workspace "others"; }

    Mod+Tab { toggle-overview; }

    Mod+Shift+1 { move-window-to-workspace "term"; }
    Mod+Shift+2 { move-window-to-workspace "web"; }
    Mod+Shift+3 { move-window-to-workspace "mail"; }
    Mod+Shift+4 { move-window-to-workspace "chat"; }
    Mod+Shift+5 { move-window-to-workspace "media"; }
    Mod+Shift+6 { move-window-to-workspace "games"; }
    Mod+Shift+7 { move-window-to-workspace "office"; }
    Mod+Shift+8 { move-window-to-workspace "vm"; }
    Mod+Shift+9 { move-window-to-workspace "others"; }

    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }

    Mod+Shift+Left { set-column-width "-10%"; }
    Mod+Shift+Right { set-column-width "+10%"; }
    Mod+Shift+Up { set-window-height "-10%"; }
    Mod+Shift+Down { set-window-height "+10%"; }

    Mod+Shift+Ctrl+Left { move-workspace-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-workspace-to-monitor-right; }
    Mod+Shift+Ctrl+Up { move-workspace-to-monitor-up; }
    Mod+Shift+Ctrl+Down { move-workspace-to-monitor-down; }

    Mod+WheelScrollDown { focus-workspace-down; }
    Mod+WheelScrollUp { focus-workspace-up; }

    Alt+F4 { close-window; }
    Mod+F { maximize-window-to-edges; }
    Mod+Shift+F { fullscreen-window; }
    Mod+H { toggle-window-floating; }

    Mod+Q { spawn "kitty"; }
    {{- $emailClient := "betterbird" }}
    {{- if eq .osid "linux-gentoo" }}
    {{-   $emailClient = "betterbird-bin" }}
    {{- else if eq .osid "linux-ubuntu" "linux-linuxmint" }}
    {{-   $emailClient = "/opt/betterbird/betterbird" }}
    {{- end }}
    Mod+M { spawn "{{ $emailClient }}" "-P"; }
    Mod+Z { spawn "ndrop" "kitty" "--class" "btop" "-e" "btop"; }
    Mod+T { spawn "ndrop" "thunar"; }

    {{- if eq .browser "FIREFOX" }}
    Mod+E { spawn "firefox" "-P"; }
    {{- else if eq .browser "ZEN" }}
    {{-   $browser := "zen-browser" }}
    {{-   if eq .osid "linux-ubuntu" "linux-linuxmint" }}
    {{-     $browser = "zen" }}
    {{-   end }}
    Mod+E { spawn "{{ $browser }}" "-P"; }
    {{- end }}

    // Core Noctalia binds
    Ctrl+Alt+Delete { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+L { spawn-sh "noctalia msg session lock"; }
    Mod+C { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+X { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+S { spawn-sh "noctalia msg screenshot-region"; }
    Mod+Shift+S { spawn-sh "noctalia msg screenshot-annotate"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher hold"; }
    // Niri has a built-in window switcher you might want to try it to see which one you prefer.

    // Audio & Brightness
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "noctalia msg media play"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "noctalia msg media pause"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
}
