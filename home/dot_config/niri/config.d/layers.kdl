// Layer rules
/*
  Noctalia
  Disable xray on all our surfaces so it looks more realistic.
  Noctalia publishes blur regions automatically when ext-background-effects is available.
*/
layer-rule {
  match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
  background-effect {
    xray false
    // blur false
  }
}

/* Enable blur on noctalia's window switcher and disable xray. */
layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}
layer-rule {
    match namespace="^notifications$"
    opacity 0.9
    block-out-from "screencast"
}
layer-rule {
    match namespace="swaync-control-center"
    opacity 0.9
    geometry-corner-radius 12
    background-effect {
        blur true
    }
}
layer-rule {
    match namespace="gtk-layer-shell"
    opacity 0.9
}
layer-rule {
    match namespace="waybar"
    opacity 0.9
    shadow {
        on
        softness 150
        spread 5
        offset x=0 y=5
        draw-behind-window true
    }
    geometry-corner-radius 12
}
layer-rule {
    match namespace="^walker$"
    opacity 0.95
    block-out-from "screencast"
}
