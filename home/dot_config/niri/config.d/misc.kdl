// Misc settings.
screenshot-path "~/Pictures/Screenshots/screenshot_%Y-%m-%d-%H%M%S.png"

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

// Also ask windows to omit client-side decorations, so that
// they don't draw their own window shadows.
prefer-no-csd

// recent windows (alt-tab)
recent-windows {
    on
    debounce-ms 750

    open-delay-ms 150

    highlight {
        padding 30
        corner-radius 0
    }

    previews {
        max-height 480
        max-scale 0.5
    }

    binds {
        Alt+Tab         { next-window     scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
    }
}

xwayland-satellite {
    path "xwayland-satellite"
}

debug {
  // Allows notification actions and window activation from Noctalia.
  honor-xdg-activation-with-invalid-serial
}

/* You can also fine-tune the blur effect globally. */
blur {
  passes 2        // more passes = stronger blur (default: 3)
  offset 3.0      // sample distance per pass (default: 3.0)
  noise 0.03      // grain overlay (default: 0.02)
  saturation 1.0  // color saturation boost (default: 1.5)
}
