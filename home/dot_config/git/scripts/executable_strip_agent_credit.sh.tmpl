#!{{ .bash }}
# @file strip_agent_credit.sh
# @brief Drop the lines where an AI agent credits itself in a commit message
# @description Run by the global `commit-msg` hook (`hook.strip-agent-credit` in
# the git config), before `commit_message.sh` checks what is left. The human
# author is the only author: the git-conventions rule forbids an agent to add
# these lines, and this hook removes them when one does anyway.
{{ template "git/hooks/modern_bash.sh.tmpl" . }}
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
dybatpho::register_common_handlers

#######################################
# @description Rewrite the message file without its agent credit lines
# @arg $1 string Path of the message file git hands the hook
#######################################
function _main {
  local file
  dybatpho::expect_args file -- "$@"
  # Agents are told apart by their whole address, not their name or domain: a
  # human co-author may be called Claude, or work at openai.com.
  local agents='noreply@anthropic\.com|cursoragent@cursor\.com|(codex|noreply)@openai\.com'
  agents+='|[^>@]*@aider\.chat'
  local bots='copilot|copilot-swe-agent\[bot\]|chatgpt-codex-connector\[bot\]'
  bots+='|devin-ai-integration\[bot\]|gemini-code-assist\[bot\]'
  agents+="|([0-9]+\+)?(${bots})@users\.noreply\.github\.com"
  local tools='claude|copilot|github copilot|codex|cursor|gemini|aider|devin'
  local -a credit=(
    -e "^co-authored-by:.*<(${agents})>"
    -e '^(assisted-by|claude-session):'
    -e '^https://claude\.ai/code/session_'
    # "🤖 Generated with [Claude Code](…)": the agent right after "with", so
    # neither "Generated by mockery for the Cursor…" nor "…claude-api".
    -e "^[^[:alnum:]]*generated (with|by) \\[?(${tools})([^[:alnum:]-]|\$)"
  )
  # Byte by byte (C locale): in a UTF-8 locale a latin1 line reads as
  # binary, and grep would silently leave it out.
  local status=0
  LC_ALL=C grep -qiE "${credit[@]}" -- "${file}" || status=$?
  # Nothing to drop: leave the file exactly as git wrote it.
  ((status != 1)) || return 0
  ((status == 0)) || dybatpho::die "Could not read ${file}"
  local kept
  # Exits 1 when every line was credit, which leaves an empty message.
  kept="$(LC_ALL=C grep -viE "${credit[@]}" -- "${file}")" || true
  printf '%s\n' "${kept}" > "${file}"
}

_main "$@"
