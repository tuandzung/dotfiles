#!{{ .bash }}
# @file commit_message.sh
# @brief Reject a commit message that breaks the commit conventions
# @description Run by the global `commit-msg` hook (`hook.commit-message` in the
# git config), after `strip_agent_credit.sh` has dropped any agent credit.
# Reject an empty message and a subject over 72 characters, and warn when the
# subject goes over the 50 character mark.
{{ template "git/hooks/modern_bash.sh.tmpl" . }}
# dybatpho falls back to these unprefixed names, which a project's own env sets
# for itself (LOG_LEVEL=WARNING aborts it); DYBATPHO_LOG_* still applies.
unset LOG_LEVEL LOG_FORMAT LOG_FILE LOG_FILE_LEVEL LOG_FILE_MAX_BYTES LOG_FILE_MAX_BACKUPS LOG_REQUEST_ID
dybatpho_init="{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh"
# Fail open: a moved, half checked out or broken library must not block every
# commit. Try it in a throwaway subshell, where its own exit cannot reach us.
# shellcheck source=/dev/null
if ! (. "${dybatpho_init}" && declare -F dybatpho::register_common_handlers \
  dybatpho::expect_args dybatpho::die dybatpho::warn) &> /dev/null; then
  echo "commit_message.sh: could not load dybatpho from ${dybatpho_init}, check skipped" >&2
  exit 0
fi
# shellcheck source=/dev/null
. "${dybatpho_init}" || exit 0
dybatpho::register_common_handlers

#######################################
# @description Check the subject of the message git is about to commit
# @arg $1 string Path of the message file git hands the hook
#######################################
function _main {
  local file
  dybatpho::expect_args file -- "$@"
  # The hook sees the file before git cleans it up, so clean it the same way:
  # drop the scissors section, and the comment lines (in core.commentChar)
  # only in the modes that strip them; scissors keeps those above the cut.
  # ponytail: git's --cleanup flag never reaches a hook, and the default mode
  # keeps comments with -m: there a "#42 fix" subject is taken for a comment.
  local cleanup strip=--strip-comments
  cleanup="$(git config --get commit.cleanup)" || true
  case "${cleanup}" in
    scissors | whitespace | verbatim) strip="" ;;
  esac
  local subject
  subject="$(sed -e '/^. -\{24\} >8 -\{24\}$/,$d' -- "${file}" \
    | git stripspace ${strip:+"${strip}"} | sed -n '1p')"
  [[ -n "${subject}" ]] || dybatpho::die "Commit message is empty"
  # Count UTF-8 characters, not bytes, whatever locale git runs the hook in:
  # drop the continuation bytes, then count what is left.
  local length
  length="$(printf '%s' "${subject}" | LC_ALL=C tr -d '\200-\277' | wc -c)"
  length=$((length))
  if ((length > 72)); then
    local message="Subject is ${length} characters, over the 72 character limit: ${subject}"
    # Subjects git writes itself only warn: --fixup/--squash prefix one that
    # already passed (autosquash needs it verbatim, and it is squashed away),
    # and a merge or pull names a branch or a URL of any length.
    [[ "${subject}" =~ ^((fixup|squash|amend)!|Merge)\  ]] || dybatpho::die "${message}"
    dybatpho::warn "${message}"
    return 0
  fi
  ((length <= 50)) \
    || dybatpho::warn "Subject is ${length} characters, aim for 50 or fewer: ${subject}"
}

_main "$@"
