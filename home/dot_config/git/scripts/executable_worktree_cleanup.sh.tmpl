#!{{ .bash }}
# @file worktree_cleanup.sh
# @brief Remove the linked worktrees whose branch a merge just brought in
# @description Run by the global `post-merge` hook (`hook.worktree-cleanup` in
# the git config, git 2.54 or newer), which a fast-forward merge triggers too.
# A worktree goes once its branch tip landed in this merge (reachable from
# HEAD, not from ORIG_HEAD), so a fresh worktree still sitting on the old tip
# is kept. The branch itself is kept, and so is any worktree holding anything
# git would not give back: a change, an untracked or ignored file, or a dirty
# submodule.
{{ template "git/hooks/modern_bash.sh.tmpl" . }}
. "{{ .chezmoi.sourceDir }}/../scripts/lib/dybatpho/init.sh" --modules git
dybatpho::register_common_handlers

#######################################
# @description Remove every clean worktree whose branch this merge brought in
# @noargs
#######################################
function _main {
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
  git rev-parse --verify --quiet ORIG_HEAD > /dev/null || return 0
  local here
  here="$(git rev-parse --path-format=absolute --show-toplevel)"

  local wt branch tip first=true worktrees=""
  while IFS=$'\t' read -r wt branch; do
    # The first one listed is the main checkout, never removed.
    if [[ "${first}" == true ]]; then
      first=false
      worktrees="$(realpath -- "${wt}/.worktrees" 2> /dev/null || true)"
      continue
    fi
    [[ "${wt}" != "${here}" && "${branch}" != "("* ]] || continue
    # The list comes from .git/worktrees/*/gitdir, which a sandboxed agent can
    # write: only a real directory right under .worktrees/ is ever removed.
    if [[ -z "${worktrees}" || -L "${wt}" ]] \
      || [[ "$(dybatpho::path_dirname "$(realpath -- "${wt}")")" != "${worktrees}" ]]; then
      continue
    fi
    tip="refs/heads/${branch}"
    dybatpho::git_is_ancestor . "${tip}" HEAD || continue
    ! dybatpho::git_is_ancestor . "${tip}" ORIG_HEAD || continue
    local leftover
    # ignore=all in .gitmodules would otherwise hide a dirty submodule.
    leftover="$(git -C "${wt}" status --porcelain --ignored --untracked-files=all \
      --ignore-submodules=none 2>&1)" || leftover="git status failed"
    # A linked worktree keeps its submodule repositories in its own git dir:
    # a commit no remote has would go with it.
    # shellcheck disable=SC2016 # displaypath is set by git for each submodule
    leftover+="$(git -C "${wt}" submodule foreach --quiet --recursive \
      '[ -n "$(git branch -r --contains HEAD 2> /dev/null)" ] || echo "$displaypath"' 2>&1)" \
      || leftover+="git submodule foreach failed"
    if [[ -n "${leftover}" ]]; then
      dybatpho::warn "Kept ${wt}: it still holds changes, untracked files or unpushed submodule commits"
      continue
    fi
    # --force only for the submodules it may hold, the checks above found nothing to lose.
    if git worktree remove --force "${wt}"; then
      dybatpho::info "Removed worktree ${wt}, branch ${branch} kept"
    else
      dybatpho::warn "Could not remove ${wt}"
    fi
  done < <(dybatpho::git_worktree_list . || true)
}

_main
