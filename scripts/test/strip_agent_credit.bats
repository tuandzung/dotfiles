#!/usr/bin/env bats
# @file strip_agent_credit.bats
# @brief Tests for home/dot_config/git/scripts/executable_strip_agent_credit.sh.tmpl
# @description
#   Runs the rendered hook by hand on a message file, the way git's `commit-msg`
#   event calls it, and checks what is left in the file. The lines to drop are
#   the ones the git-conventions rule forbids an agent to add.

setup_file() {
  command -v chezmoi > /dev/null || skip "chezmoi is not installed"
  local root
  root="$(realpath "${BATS_TEST_DIRNAME}/../..")"
  HOOK="${BATS_FILE_TMPDIR}/strip_agent_credit.sh"
  chezmoi execute-template --source "${root}" \
    --file "${root}/home/dot_config/git/scripts/executable_strip_agent_credit.sh.tmpl" > "${HOOK}"
  export HOOK
}

setup() {
  MSG="${BATS_TEST_TMPDIR}/COMMIT_EDITMSG"
}

@test "a Co-Authored-By trailer naming an agent is dropped, the message kept" {
  cat > "${MSG}" << 'MSG'
feat(git): add a hook

Why it matters.

Co-Authored-By: Claude Opus <noreply@anthropic.com>
MSG
  run bash "${HOOK}" "${MSG}"
  [ "${status}" -eq 0 ]
  run cat "${MSG}"
  [[ "${output}" == $'feat(git): add a hook\n\nWhy it matters.'* ]]
  [[ "${output}" != *"Co-Authored-By"* ]]
}

@test "a human co-author stays, any agent goes, whatever the key's case" {
  cat > "${MSG}" << 'MSG'
fix: something

Co-authored-by: Jane Doe <jane@example.com>
Co-authored-by: Claude Monet <claude@example.com>
co-authored-by: Copilot <175728472+Copilot@users.noreply.github.com>
CO-AUTHORED-BY: Codex <codex@openai.com>
Co-authored-by: Codex <noreply@openai.com>
Co-authored-by: chatgpt-codex-connector[bot] <1+chatgpt-codex-connector[bot]@users.noreply.github.com>
Co-authored-by: Copilot <copilot-swe-agent[bot]@users.noreply.github.com>
Co-authored-by: Cursor Agent <cursoragent@cursor.com>
Co-authored-by: aider (openai/gpt-4o) <aider@aider.chat>
Co-authored-by: devin-ai-integration[bot] <158243242+devin-ai-integration[bot]@users.noreply.github.com>
Co-authored-by: gemini-code-assist[bot] <176961590+gemini-code-assist[bot]@users.noreply.github.com>
MSG
  run bash "${HOOK}" "${MSG}"
  [ "${status}" -eq 0 ]
  run cat "${MSG}"
  [ "${output}" = "fix: something

Co-authored-by: Jane Doe <jane@example.com>
Co-authored-by: Claude Monet <claude@example.com>" ]
}

@test "session, assistance and generated-with credit goes, a human line stays" {
  cat > "${MSG}" << 'MSG'
build: regenerate the client

Generated with protoc from the new schema.

🤖 Generated with [Claude Code](https://claude.com/claude-code)
https://claude.ai/code/session_01AbCdEf
Assisted-by: Claude:claude-opus-5-5
Claude-Session: https://claude.ai/code/session_01AbCdEf
MSG
  run bash "${HOOK}" "${MSG}"
  [ "${status}" -eq 0 ]
  run cat "${MSG}"
  [[ "${output}" == "build: regenerate the client

Generated with protoc from the new schema."* ]]
  [[ "${output}" != *"laude"* ]]
}

@test "a message that is not UTF-8 is kept byte for byte" {
  # i18n.commitEncoding = latin1: grep in a UTF-8 locale takes it for binary.
  printf 'fix: caf\xe9 menu\n\nExplain the caf\xe9 change.\nSecond line.\n' > "${MSG}"
  cp "${MSG}" "${MSG}.orig"
  LC_ALL=C.UTF-8 run bash "${HOOK}" "${MSG}"
  [ "${status}" -eq 0 ]
  cmp "${MSG}" "${MSG}.orig"
}

@test "a message file it cannot read is rejected, never rewritten" {
  printf 'fix: x\n\nbody\n' > "${MSG}"
  chmod 200 "${MSG}"
  run bash "${HOOK}" "${MSG}"
  chmod 600 "${MSG}"
  [ "${status}" -ne 0 ]
  [ "$(cat "${MSG}")" = $'fix: x\n\nbody' ]
}

@test "people and tools that only look like an agent stay" {
  cat > "${MSG}" << 'MSG'
chore: regen mocks

Generated by mockery for the Cursor interface.
- Generated with the precursor script
Generated by claude-api schema v2
Unlike the old docs, nothing here was generated by Copilot.

Co-authored-by: Jane Roe <jane@openai.com>
Co-authored-by: Bob <bob@cursor.com>
Co-authored-by: Ann <1234+xcopilot@users.noreply.github.com>
MSG
  cp "${MSG}" "${MSG}.orig"
  run bash "${HOOK}" "${MSG}"
  [ "${status}" -eq 0 ]
  cmp "${MSG}" "${MSG}.orig"
}

@test "a project's own LOG_FILE never gets the hook's log lines" {
  cd "${BATS_TEST_TMPDIR}" || return 1
  printf 'fix: x\n' > "${MSG}"
  chmod 200 "${MSG}"
  LOG_FILE=app.log run bash "${HOOK}" "${MSG}"
  chmod 600 "${MSG}"
  [ "${status}" -ne 0 ]
  [ ! -e app.log ]
}

@test "without dybatpho the message is left as it is, with a warning" {
  cd "${BATS_TEST_TMPDIR}" || return 1
  sed 's|/scripts/lib/dybatpho/init.sh|/scripts/lib/gone/init.sh|' "${HOOK}" > nolib.sh
  printf 'fix: x\n\nCo-Authored-By: Claude <noreply@anthropic.com>\n' > "${MSG}"
  cp "${MSG}" "${MSG}.orig"
  run bash nolib.sh "${MSG}"
  [ "${status}" -eq 0 ]
  [[ "${output}" == *"dybatpho not found"*"skipped"* ]]
  [[ "${output}" != *"command not found"* ]]
  cmp "${MSG}" "${MSG}.orig"
}
